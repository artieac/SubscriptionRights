# Copy this file to .env (same directory as docker-compose.yml) and fill in real values.
# .env is gitignored -- never commit your actual secrets.
#
# Every SUBSCRIPTIONS_* var below is optional: whatever you leave unset falls back to the
# default-value already baked into backend/src/main/resources/application.yml (fine for a quick
# local smoke test, wrong for a real deployment -- e.g. the JWT secret default is a placeholder).

# ---- Ports (host and container both use these -- see docker-compose.yml) ----
SUBSCRIPTIONS_SERVER_PORT=8087
SUBSCRIPTIONS_FRONTEND_HTTP_PORT=5175

# ---- Frontend build arg (baked into the JS bundle at image-build time, not changeable at
# container-start time -- see frontend/Dockerfile) ----
# Must point at wherever the backend service is actually reachable from the browser.
VITE_API_BASE_URL=http://localhost:8087

# ---- Database (real external MySQL -- this compose file does not run one for you) ----
SUBSCRIPTIONS_DB_URL=jdbc:mysql://host.docker.internal:3306/subscriptionentitlements?useSSL=false&allowPublicKeyRetrieval=true
SUBSCRIPTIONS_DB_USERNAME=
SUBSCRIPTIONS_DB_PASSWORD=

# ---- Configuration API (leave SUBSCRIPTIONS_CONFIG_API_BASE_URL unset to skip it entirely and
# use the SUBSCRIPTIONS_* defaults/values below directly) ----
SUBSCRIPTIONS_CONFIG_API_BASE_URL=
SUBSCRIPTIONS_CONFIG_API_SYSTEM_ID=Subscriptions
SUBSCRIPTIONS_CONFIG_API_ENVIRONMENT_ID=Production
SUBSCRIPTIONS_CONFIG_API_KEY=

# ---- Auth0 ----
SUBSCRIPTIONS_AUTH0_DOMAIN=alwaysmoveforward.auth0.com
SUBSCRIPTIONS_AUTH0_CLIENT_ID=
SUBSCRIPTIONS_AUTH0_CLIENT_SECRET=

# ---- Session cookie ----
SUBSCRIPTIONS_APP_JWT_SECRET=change-this-to-a-long-random-secret-in-every-real-environment
SUBSCRIPTIONS_JWT_COOKIE_NAME=SubscriptionCookie
SUBSCRIPTIONS_COOKIE_DOMAIN=subscriptions.alwaysmoveforward.com

# ---- Comma-separated emails auto-promoted to admin on login ----
SUBSCRIPTIONS_ADMIN_EMAILS=artieac@gmail.com
